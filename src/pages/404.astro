---
import Main from '../layouts/main.astro';
import { getLangFromUrl, useTranslations, withBase } from '../i18n/utils';
import Section from '../components/Section.astro';
const currentPath = Astro.url.pathname;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const redirectUrl = withBase(`/${lang}`);
---

<Main hideNav="true">
  <Section class:list="text-center">
    <p class="text-3xl mb-6">404</p>
    <p class="text-sm mb-4">{currentPath}</p>
    <a href=`${redirectUrl}`>{t('common.home')}</a>
    <div class=""></div>
  </Section>
</Main>
