---
import Main from '../layouts/main.astro';
import { getLangFromUrl, useTranslations, withBase } from '../i18n/utils';
import Section from '../components/Section.astro';
import { LAYOUT_TYPE_KEY } from '../config/layout';
const currentPath = Astro.url.pathname;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const redirectUrl = withBase(`/${lang}`);
---

<Main title={t('site.title')} layout={LAYOUT_TYPE_KEY.COL_3}>
  <Section id='404-page'>
    <p class='mb-6 text-3xl'>404</p>
    <p class='mb-4 text-sm'>{currentPath}</p>
    <a href=`${redirectUrl}`>{t('common.home')}</a>
    <div class=''></div>
  </Section>
</Main>
