---
import '../styles/global.css';
import { getLangFromUrl } from '../i18n/utils';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BaseHead from '../components/BaseHead.astro';
import { ClientRouter } from 'astro:transitions';
import PageLoader from '../components/PageLoader.astro';
import BackgroundOverlay from '../components/BackgroundOverlay.astro';

const lang = getLangFromUrl(Astro.url);

const {
  title,
  description = 'Advokat Dubravka Vuković website',
  image,
} = Astro.props;
---

<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} image={image} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <ClientRouter />
    <script src="../scripts/nprogress-handler.ts"></script>
  </head>
  <!-- <body class="grid min-h-screen grid-rows-[auto_1fr_auto]"> -->
  <body>
    <PageLoader />
    <BackgroundOverlay />
    <Header />
    <main
      id="main"
      class="w-full mx-auto min-h-[calc(100vh-54px)] md:min-h-[calc(100vh-84px)] mb-118 lg:mb-82 px-4 md:px-8 bg-(--background) z-10 pb-20"
    >
      <div class="w-full h-full max-w-400 mx-auto mt-15 md:mt-21">
        <slot />
      </div>
    </main>
    <Footer />
    <script src="../scripts/global-mediator.ts"></script>

    <script>
      const loader = document.getElementById('full-page-loader');

      let loadingTimeout: ReturnType<typeof setTimeout>;

      document.addEventListener('astro:before-preparation', () => {
        // Only reveal overlay if loading takes longer than 200ms
        loadingTimeout = setTimeout(() => {
          document
            .getElementById('full-page-loader')
            ?.classList.remove('hidden');
        }, 200);
      });

      document.addEventListener('astro:after-swap', () => {
        clearTimeout(loadingTimeout);
        document.getElementById('full-page-loader')?.classList.add('hidden');
      });

      // Fallback safety to ensure hidden status once rendering settles
      document.addEventListener('astro:page-load', () => {
        loader?.classList.add('hidden');
      });
    </script>
  </body>
</html>
