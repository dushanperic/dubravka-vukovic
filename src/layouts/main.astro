---
import '../styles/global.css';
import { getLangFromUrl, useTranslations, withBase } from '../i18n/utils';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BaseHead from '../components/BaseHead.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { title, description, image } = Astro.props;
---

<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} image={image} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <!-- <title>{t('site.title')}</title> -->
    <!-- 
    <script is:inline>
      (function () {
        const getThemeByTime = () => {
          const hour = new Date().getHours();
          return hour >= 6 && hour < 18 ? 'light' : 'dark';
        };
        const savedTheme = localStorage.getItem('theme');
        const theme = savedTheme ? savedTheme : getThemeByTime();
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script> -->
  </head>
  <body>
    <div class="grid min-h-screen grid-rows-[auto_1fr_auto] px-4">
      <Header />
      <main
        class="w-full max-w-300 mx-auto grow-3 overflow-y-scroll flex items-start justify-center mt-32"
      >
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
