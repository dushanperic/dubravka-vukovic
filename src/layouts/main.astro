---
import '../styles/global.css';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BaseHead from '../components/BaseHead.astro';
import { ClientRouter } from 'astro:transitions';
import BackgroundOverlay from '../components/BackgroundOverlay.astro';
import LangPicker from '../components/LangPicker.astro';
import Container from '../components/ui/Container.astro';
import {
  LAYOUT_TYPE_KEY,
  layoutTwClass,
  type LayoutKeyType,
} from '../config/layout';

interface Props {
  title: string;
  pageTitle?: string;
  description?: string;
  image?: string;
  layout?: LayoutKeyType;
}

interface AdditionalHeadContent {
  script?: string;
  link?: string;
  meta?: string;
}

interface ExtendedProps extends Props {
  additionalHeadContent?: AdditionalHeadContent;
}

const {
  title,
  pageTitle,
  description = 'Advokat Dubravka Vuković website',
  image,
  layout,
  additionalHeadContent,
} = Astro.props as ExtendedProps;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const getLayoutClass = (layout: LayoutKeyType | undefined) => {
  if (!layout) return layoutTwClass[LAYOUT_TYPE_KEY.DEFAULT];
  return layout
    ? layoutTwClass[layout]
    : layoutTwClass[LAYOUT_TYPE_KEY.DEFAULT];
};
---

<html lang={lang} transition:animate='none'>
  <head>
    <BaseHead title={title} description={description} image={image} />
    <ClientRouter transition:animate='none' />
    {
      additionalHeadContent?.script && (
        <script src={additionalHeadContent.script} />
      )
    }
    {additionalHeadContent?.link && <link rel={additionalHeadContent?.link} />}
    {additionalHeadContent?.meta && <meta name={additionalHeadContent?.meta} />}
  </head>
  <body>
    <a
      href='#main'
      class='skip-link fixed top-2 left-2 z-50 -translate-y-[150%] bg-(--background) px-4 py-2 text-(--text) shadow-lg focus:translate-y-0'
    >
      {t('a11y.skip_to_content')}
    </a>
    <!-- 🎞️ Curtain Transition Overlay -->
    <div
      id='page-curtain'
      transition:persist='page-curtain'
      aria-hidden='true'
      class='flex items-center justify-center'
    >
      <p class='text-xs! uppercase'>{t('site.title')}</p>
    </div>
    <BackgroundOverlay />
    <Header title={pageTitle} />

    <main
      id='main'
      tabindex='-1'
      class='z-10 mx-auto mb-78.5 min-h-[100dvh] w-full bg-(--background) pb-8 lg:mb-74'
    >
      <Container>
        <div
          class='min-h-[100dvh] w-full'
          class:list={[getLayoutClass(layout)]}
        >
          {layout !== LAYOUT_TYPE_KEY.CENTERED && <div />}
          <slot />
        </div>
        <!-- Sticky LangPicker aligned to Column 1 -->
        <div
          class='invisible sticky bottom-10 z-20 inline-block h-0 md:visible'
        >
          <LangPicker />
        </div>
      </Container>
    </main>
    <Footer />
    <script src='../scripts/global-mediator.ts'></script>
    <script src='../scripts/page-curtain.ts'></script>
  </body>
</html>
