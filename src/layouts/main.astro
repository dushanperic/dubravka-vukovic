---
import '../styles/global.css';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BaseHead from '../components/BaseHead.astro';
import { ClientRouter } from 'astro:transitions';
import BackgroundOverlay from '../components/BackgroundOverlay.astro';
import LangPicker from '../components/LangPicker.astro';
import { curtainWipe } from '../config/page-transitions';

const {
  title,
  description = 'Advokat Dubravka Vuković website',
  image,
  layout,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<html lang={lang} transition:animate={curtainWipe}>
  <head>
    <BaseHead title={title} description={description} image={image} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <ClientRouter transition:animate="none" />
    <script src="../scripts/nprogress-handler.ts"></script>
  </head>
  <body class="view-wipe-container">
    <BackgroundOverlay />
    <Header />

    <!-- 🎞️ Pure Color Curtain Overlay Container -->
    <div
      id="curtain-wipe"
      transition:persist="curtain-container"
      class="fixed inset-0 h-screen w-screen bg-gray-200 z-50 pointer-events-none curtain-reset flex flex-col items-center justify-center"
    >
      <!-- 🏷️ Clean Static Text Block -->
      <p class="text-xs! font-bold uppercase tracking-widest select-none">
        {t('site.title')}
      </p>
    </div>
    <main
      id="main"
      class="w-full mx-auto mb-103 lg:mb-73 px-6 md:px-8 bg-(--background) z-10 pb-8"
    >
      <div
        class="w-full min-h-screen max-w-400 mx-auto"
        class:list={layout === 'centered'
          ? 'flex items-center justify-center'
          : 'md:grid md:grid-cols-[1fr_2fr] pt-20 lg:pt-10'}
      >
        {layout !== 'centered' && <div />}
        <slot />
      </div>
      <div
        class="w-auto sticky bottom-10 left-8 text-left invisible lg:visible"
      >
        <LangPicker />
      </div>
    </main>
    <Footer />
    <script src="../scripts/global-mediator.ts"></script>

    <script>
      const loader = document.getElementById('full-page-loader');

      let loadingTimeout: ReturnType<typeof setTimeout>;

      document.addEventListener('astro:before-preparation', () => {
        // Only reveal overlay if loading takes longer than 200ms
        loadingTimeout = setTimeout(() => {
          document
            .getElementById('full-page-loader')
            ?.classList.remove('hidden');
        }, 200);
      });

      document.addEventListener('astro:after-swap', () => {
        clearTimeout(loadingTimeout);
        document.getElementById('full-page-loader')?.classList.add('hidden');
      });

      // Fallback safety to ensure hidden status once rendering settles
      document.addEventListener('astro:page-load', () => {
        loader?.classList.add('hidden');
      });
    </script>
  </body>
</html>

<script>
  declare global {
    interface Window {
      __curtainListenersAttached?: boolean;
    }
  }

  import type { TransitionBeforePreparationEvent } from 'astro:transitions/client';

  if (!window.__curtainListenersAttached) {
    document.addEventListener('astro:before-preparation', (ev: Event) => {
      const transitionEvent = ev as TransitionBeforePreparationEvent;
      if (!transitionEvent.to) return;

      transitionEvent.loader = async (): Promise<void> => {
        const curtain = document.getElementById('curtain-wipe');
        if (curtain) {
          curtain.className =
            'fixed inset-0 w-screen h-screen bg-gray-200 z-50 pointer-events-none curtain-up flex flex-col items-center justify-center';
        }

        try {
          // ⏳ THE FIX: Run the network fetch and a fixed 500ms animation timer side-by-side.
          // This prevents the page from swapping prematurely if the network is too fast.
          const [response] = await Promise.all([
            fetch(transitionEvent.to.href),
            new Promise((resolve) => setTimeout(resolve, 500)), // Matches --animate-wipe-up exactly
          ]);

          if (!response.ok) throw new Error('Network response failure');

          const htmlText = await response.text();
          const parser = new DOMParser();
          const newDocument = parser.parseFromString(htmlText, 'text/html');

          // Brief settle window before handing over to the swap event
          await new Promise((resolve) => setTimeout(resolve, 50));
          transitionEvent.newDocument = newDocument;
        } catch (error) {
          console.error('Loader failed, falling back:', error);
        }
      };
    });

    // Slide away out the top when content swap finishes
    document.addEventListener('astro:after-swap', () => {
      const curtain = document.getElementById('curtain-wipe');
      if (curtain) {
        curtain.className =
          'fixed inset-0 w-screen h-screen bg-gray-200 z-50 pointer-events-none curtain-down flex flex-col items-center justify-center';
      }
    });

    // Silently slide the overlay back to the bottom floor when transition completes
    document.addEventListener('astro:page-load', () => {
      const curtain = document.getElementById('curtain-wipe');

      if (curtain && curtain.classList.contains('curtain-down')) {
        // Wait 400ms matching the --animate-wipe-down exit duration perfectly
        setTimeout(() => {
          curtain.className =
            'fixed inset-0 w-screen h-screen bg-gray-200 z-50 pointer-events-none curtain-reset flex flex-col items-center justify-center';
        }, 400);
      }
    });

    window.__curtainListenersAttached = true;
  }
</script>
