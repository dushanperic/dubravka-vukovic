---
import { languages } from '../i18n/ui';
import { getLocalizedURL } from '../scripts/lang-picker';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const currentPath = Astro.url.pathname.startsWith(`${base}/`)
  ? Astro.url.pathname.slice(base.length)
  : Astro.url.pathname;
---

<ul class="inline-flex items-center justify-center gap-1">
  {
    Object.entries(languages).map(([lang, label], index) => (
      <li class="flex items-center justify-center gap-1">
        <a href={getLocalizedURL(lang, currentPath)}>{label}</a>
        <span
          class="w-px h-3 bg-(--text)"
          class:list={
            index < Object.keys(languages)?.length - 1 ? 'block' : 'hidden'
          }
        />
      </li>
    ))
  }
</ul>
