---
interface Props {
  text: string;
  maxWidth?: string;
}

const { text, maxWidth = '600px', ...rest } = Astro.props;
---

<div class="text-container" style={`max-width: ${maxWidth};`}>
  <p class="animate-lines" {...rest}>
    {text}
  </p>
</div>

<style>
  .text-container {
    /* margin: 50px auto 50px 0; */
    /* font-size: 24px; */
    line-height: 1.4;
  }

  /* The row container acts as a mask, clipping everything below it */
  :global(.line) {
    overflow: hidden; /* Hides letters below the row */
    display: block;
    padding-bottom: 4px; /* Prevents descenders like 'g' or 'y' from clipping */
  }
</style>

<script>
  import gsap from 'gsap';
  import SplitType from 'split-type';

  const textElements = document.querySelectorAll('.animate-lines');

  textElements.forEach((element) => {
    // 1. Split text strictly into lines
    const splitText = new SplitType(element as HTMLElement, { types: 'lines' });

    // 2. Safely collect the line elements generated by SplitType
    const lines = gsap.utils.toArray(element.querySelectorAll('.line'));

    if (lines.length > 0) {
      // 3. Set initial state: shifted completely down below the row boundary
      gsap.set(lines, {
        y: '100%',
        opacity: 0,
      });

      // 4. Slide up linearly into view row-by-row
      gsap.to(lines, {
        y: '0%',
        opacity: 1,
        duration: 0.8,
        ease: 'power3.out', // Smooth decelerating slide
        stagger: 0.1, // Delays each row slightly after the previous one
      });
    }

    // 5. Clean recalculation on window resize
    let resizeTimer: number;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        splitText.split({ types: 'lines' });

        const activeLines = gsap.utils.toArray(
          element.querySelectorAll('.line'),
        );
        gsap.set(activeLines, { y: '0%', opacity: 1 });
      }, 250);
    });
  });
</script>
