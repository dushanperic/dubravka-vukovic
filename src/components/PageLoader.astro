---

<div
  id="full-page-loader"
  class="hidden fixed top-0 left-0 w-screen h-screen bg-[rgba(
      255,
      255,
      255,
      0.85
    )] backdrop-blur-md flex flex-col items-center justify-center gap-4 z-9999 opacity-100 transition-opacity duration-200"
  transition:persist
>
  <div class="spinner"></div>
</div>

<style>
  .spinner {
    width: 35px;
    height: 35px;
    border: 2px solid transparent;
    border-top: 2px solid var(--text);
    border-radius: 50%;
    animation: spin 0.5s linear infinite;
  }

  @keyframes spin {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }
</style>
