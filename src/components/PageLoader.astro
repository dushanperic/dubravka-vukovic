---
import { useTranslations, getLangFromUrl } from '../i18n/utils';

const url = Astro.url;
const lang = getLangFromUrl(url);
const t = useTranslations(lang);
---

<!-- src/components/PageLoader.astro -->
<div
  id="full-page-loader"
  class="hidden fixed top-0 left-0 w-screen h-screen bg-[rgba(
      255,
      255,
      255,
      0.85
    )] backdrop-blur-md flex flex-col items-center justify-center gap-4 z-9999 opacity-100 transition-opacity duration-200"
  transition:persist
>
  <!-- OPTION A: Minimalist Spinner -->
  <!-- <div class="spinner"></div> -->
  <div
    class="relative flex items-center justify-center rounded-full w-10 h-10 min-w-10 min-h-10 leading-0 border-2 animate-spin"
  >
    <div class="absolute top-1/2 left-1/2 -translate-y-0.5 -translate-1/2">
      §
    </div>
  </div>
  <div>{t('site.prefix')} {t('site.name')}</div>

  <!-- OPTION B: Layout Skeleton Template (Uncomment if preferred over spinner) -->
  <!-- 
  <div class="skeleton-wrapper">
    <div class="skeleton skeleton-header"></div>
    <div class="skeleton skeleton-title"></div>
    <div class="skeleton skeleton-text"></div>
    <div class="skeleton skeleton-text"></div>
  </div> 
  -->
</div>

<style>
  /* 1. Full screen dark/blur overlay */
  .loader-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(
      255,
      255,
      255,
      0.85
    ); /* Dark mode alternative: rgba(15, 23, 42, 0.9) */
    backdrop-filter: blur(4px);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9999;
    opacity: 1;
    transition: opacity 0.25s ease-in-out;
  }

  /* Utility class to hide smoothly */
  .loader-overlay.hidden {
    opacity: 0;
    pointer-events: none;
  }

  /* --- OPTION A: CSS Spinner Styles --- */
  .spinner {
    width: 50px;
    height: 50px;
    border: 4px solid #e2e8f0;
    border-top: 4px solid #3b82f6; /* Accent color */
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  /* --- OPTION B: Skeleton Shimmer Styles --- */
  .skeleton-wrapper {
    width: 80%;
    max-width: 600px;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .skeleton {
    background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite linear;
    border-radius: 0.375rem;
  }
  .skeleton-header {
    height: 60px;
    width: 100%;
  }
  .skeleton-title {
    height: 32px;
    width: 60%;
  }
  .skeleton-text {
    height: 16px;
    width: 100%;
  }

  @keyframes shimmer {
    0% {
      background-position: -200% 0;
    }
    100% {
      background-position: 200% 0;
    }
  }
</style>
