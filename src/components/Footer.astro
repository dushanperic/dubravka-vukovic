---
import { getLangFromUrl, useTranslations, withBase } from '../i18n/utils';
import AssociationLogoLink from './AssociationLogoLink.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const year = new Date().getFullYear();
---

<footer
  class="w-full text-left pt-12 px-4 md:px-8 fixed left-0 bottom-0 z-[-1] bg-gray-100"
>
  <div class="max-w-400 mx-auto mb-10">
    <div class="py-6">
      <div class="w-full flex flex-col md:flex-row md:justify-between gap-12">
        <div class="flex flex-col gap-2">
          <a
            href="tel:+38765/862-731"
            target="_blank"
            class="block text-base! text-center border py-2 px-4 rounded-sm"
          >
            {t('footer.contact.phone')}
          </a>
          <a
            href="mailto:advokatdubravkavukovic@gmail.com"
            target="_blank"
            class="block md:w-auto truncate text-base! text-center border py-2 px-4"
          >
            {t('footer.contact.email')}
          </a>
        </div>
        <div class="flex flex-col gap-2">
          <a href={withBase(`/${lang}/terms`)} class="text-base!">
            {t('nav.terms')}
          </a>
          <a href={withBase(`/${lang}/disclaimer`)} class="text-base!">
            {t('nav.disclaimer')}
          </a>
        </div>
        <AssociationLogoLink />
      </div>
    </div>
  </div>
  <span class="text-xs! block w-full text-center p-4">
    {t('footer.copy')}
    {year}
  </span>
</footer>
