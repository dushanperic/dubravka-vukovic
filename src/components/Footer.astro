---
import { getLangFromUrl, useTranslations, withBase } from '../i18n/utils';
import AssociationLogoLink from './AssociationLogoLink.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const year = new Date().getFullYear();
---

<footer
  class="w-full text-left pt-12 fixed left-0 bottom-0 z-[-1] bg-gray-200 px-8"
>
  <div class="max-w-400 mx-auto">
    <div class="w-full grid grid-cols-1 md:grid-cols-3 gap-12 py-6 lg:py-20">
      <ul class="">
        <li>
          <a
            href="tel:+38765/862-731"
            target="_blank"
            class="block text-base! leading-relaxed!"
          >
            {t('footer.contact.phone')}
          </a>
        </li>
        <li>
          <a
            href="mailto:advokatdubravkavukovic@gmail.com"
            target="_blank"
            class="block md:w-auto truncate text-base! leading-relaxed!"
          >
            {t('footer.contact.email')}
          </a>
        </li>
      </ul>
      <nav>
        <ul class="">
          <li>
            <a
              href={withBase(`/${lang}/terms`)}
              class="text-base! leading-relaxed!"
            >
              {t('nav.terms')}
            </a>
          </li>
          <li>
            <a
              href={withBase(`/${lang}/disclaimer`)}
              class="text-base! leading-relaxed!"
            >
              {t('nav.disclaimer')}
            </a>
          </li>
        </ul>
      </nav>
      <AssociationLogoLink />
    </div>
  </div>
  <span class="text-xs! block w-full text-left md:text-center py-2 px-4">
    {t('footer.copy')}
    {year}
  </span>
</footer>
