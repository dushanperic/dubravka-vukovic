---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import AssociationLogoLink from './AssociationLogoLink.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const year = new Date().getFullYear();
---

<footer class="w-full text-left">
  <div
    class="max-w-400 mx-auto py-6 flex flex-col md:flex-row gap-4 items-start justify-between"
  >
    <div class="flex flex-col">
      <a href="tel:+38765/862-731" target="_blank" class="block">
        {t('footer.contact.phone')}
      </a>
      <a
        href="mailto:advokatdubravkavukovic@gmail.com"
        target="_blank"
        class="block"
      >
        {t('footer.contact.email')}
      </a>
    </div>
    <div>
      <AssociationLogoLink />
      <span class="text-xs! block mt-4">
        {t('footer.copy')}
        {year}
      </span>
    </div>
  </div>
</footer>
