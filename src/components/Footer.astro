---
import { getLangFromUrl, useTranslations, withBase } from '../i18n/utils';
import AssociationLogoLink from './AssociationLogoLink.astro';
import Container from './ui/Container.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const currentYear = new Date().getFullYear();
---

<footer
  class='fixed bottom-0 left-0 z-[-1] w-full bg-(--curtain-background) pt-12 text-left'
>
  <Container>
    <div
      class='grid w-full grid-cols-1 gap-(--grid-gap) py-6 lg:grid-cols-3 lg:py-20'
    >
      <ul class=''>
        <li>
          <a
            href='tel:+38765/862-731'
            class='block text-base! leading-relaxed!'
          >
            {t('footer.contact.phone')}
          </a>
        </li>
        <li>
          <a
            href='mailto:advokatdubravkavukovic@gmail.com'
            class='block truncate text-base! leading-relaxed! md:w-auto'
          >
            {t('footer.contact.email')}
          </a>
        </li>
      </ul>
      <nav aria-label={t('nav.footer')}>
        <ul class=''>
          <li>
            <a
              href={withBase(`/${lang}/terms`)}
              class='text-base! leading-relaxed!'
            >
              {t('nav.terms')}
            </a>
          </li>
          <li>
            <a
              href={withBase(`/${lang}/disclaimer`)}
              class='text-base! leading-relaxed!'
            >
              {t('nav.disclaimer')}
            </a>
          </li>
        </ul>
      </nav>
      <div class='lg:last:ms-auto'>
        <AssociationLogoLink />
      </div>
    </div>
  </Container>
  <span class='block w-full px-12 py-2 text-left text-xs! md:text-center'>
    {t('footer.copy')}
    {currentYear}
  </span>
</footer>
