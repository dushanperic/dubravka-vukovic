---
import { getLangFromUrl, useTranslations, withBase } from '../i18n/utils';
import LangPicker from './LangPicker.astro';

const pathname = Astro.url.pathname;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const isCurrentPage = (path: string) =>
  pathname.trim().endsWith(`/${path.trim()}`);
---

<navigation-controller>
  <button
    type='button'
    aria-expanded='false'
    aria-controls='primary-navigation'
    aria-label={t('nav.menu')}
    class='group relative z-100 md:hidden'
  >
    <svg
      aria-hidden='true'
      focusable='false'
      class='h-8 w-8 fill-none stroke-current stroke-2 [stroke-linecap:round]'
      viewBox='0 0 24 24'
    >
      <!-- Top Line: Morphs directly from y=8.5 to diagonal (\) -->
      <path
        d='M 4,8.5 L 20,8.5'
        class="transition-[d] duration-300 ease-[cubic-bezier(0.68,-0.55,0.27,1.55)] group-aria-expanded:[d:path('M_6,6_L_18,18')]"
      ></path>

      <!-- Bottom Line: Morphs directly from y=15.5 to diagonal (/) -->
      <path
        d='M 4,15.5 L 20,15.5'
        class="transition-[d] duration-300 ease-[cubic-bezier(0.68,-0.55,0.27,1.55)] group-aria-expanded:[d:path('M_6,18_L_18,6')]"
      ></path>
    </svg>
  </button>

  <nav
    id='primary-navigation'
    data-state='closed'
    aria-label={t('nav.primary')}
    aria-hidden='true'
    inert
    class='fixed top-0 right-0 bottom-0 left-1/2 bg-(--background) shadow-lg transition-all data-[state=closed]:translate-x-full data-[state=closed]:opacity-0 data-[state=open]:translate-0 data-[state=open]:opacity-100 md:relative md:top-auto md:right-auto md:bottom-auto md:left-auto md:translate-x-0! md:translate-none md:bg-transparent md:shadow-none data-[state=closed]:md:opacity-100'
  >
    <ul
      class='z-100 flex h-full flex-col items-start justify-center gap-4 pl-4 md:h-auto md:flex-row md:items-end md:justify-end md:gap-6 lg:pl-0'
    >
      <li>
        <a
          href={withBase(`/${lang}/areas`)}
          class:list={[isCurrentPage('areas') && 'active-link']}
          aria-current={isCurrentPage('areas') ? 'page' : undefined}
          class='leading-0'
        >
          {t('nav.areas')}
        </a>
      </li>
      <li>
        <a
          href={withBase(`/${lang}/about`)}
          class:list={[isCurrentPage('about') && 'active-link']}
          aria-current={isCurrentPage('about') ? 'page' : undefined}
          class='leading-0'
        >
          {t('nav.biography')}
        </a>
      </li>
      <li>
        <a
          href={withBase(`/${lang}/contact`)}
          class:list={[isCurrentPage('contact') && 'active-link']}
          aria-current={isCurrentPage('contact') ? 'page' : undefined}
          class='leading-0'
        >
          {t('nav.contact')}
        </a>
      </li>
      <li class='pt-8 md:hidden md:pt-0 lg:pl-10'>
        <LangPicker />
      </li>
    </ul>
  </nav>
</navigation-controller>

<script>
  import '../scripts/navigation-controller';
</script>
