---
import { getLangFromUrl, useTranslations, withBase } from '../i18n/utils';
import LangPicker from './LangPicker.astro';
import '../scripts/navigation-controller';

const pathname = Astro.url.pathname;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const getNavLinkStyle = (path: string) => {
  return pathname.includes(path) ? 'active-link' : '';
};
---

<navigation-controller>
  <button
    type='button'
    aria-expanded='false'
    class='group relative z-100 md:hidden'
    role='button'
  >
    <svg
      class='stroke-linecap-round h-8 w-8 fill-none stroke-current stroke-2'
      viewBox='0 0 24 24'
    >
      <!-- Top Line -->
      <path
        class='origin-center translate-y-1.5 transition-all duration-300 ease-in-out group-aria-expanded:translate-y-0 group-aria-expanded:rotate-45'
        d='M4 12h16'></path>
      <!-- Middle Line -->
      <path
        class='origin-center transition-all duration-300 ease-in-out group-aria-expanded:scale-x-0 group-aria-expanded:opacity-0'
        d='M4 12h16'></path>
      <!-- Bottom Line -->
      <path
        class='origin-center translate-y-1.5 transition-all duration-300 ease-in-out group-aria-expanded:translate-y-0 group-aria-expanded:-rotate-45'
        d='M4 12h16'></path>
    </svg>
  </button>

  <nav
    data-state='closed'
    role='navigation'
    class='fixed top-0 right-0 bottom-0 left-1/2 bg-(--background) shadow-lg transition-all data-[state=closed]:translate-x-full data-[state=closed]:opacity-0 data-[state=open]:translate-0 data-[state=open]:opacity-100 md:relative md:top-auto md:right-auto md:bottom-auto md:left-auto md:translate-x-0! md:translate-none md:bg-transparent md:shadow-none data-[state=closed]:md:opacity-100'
  >
    <ul
      class='z-100 flex h-full flex-col items-start justify-center gap-4 pl-4 md:h-auto md:flex-row md:items-end md:justify-end md:gap-6 lg:pl-0'
    >
      <li class=''>
        <a
          href={withBase(`/${lang}/areas`)}
          class:list={getNavLinkStyle('areas')}
          class='leading-0'
        >
          {t('nav.areas')}
        </a>
      </li>
      <li class=''>
        <a
          href={withBase(`/${lang}/about`)}
          class:list={getNavLinkStyle('about')}
          class='leading-0'
        >
          {t('nav.biography')}
        </a>
      </li>
      <li class=''>
        <a
          href={withBase(`/${lang}/contact`)}
          class:list={getNavLinkStyle('contact')}
          class='leading-0'
        >
          {t('nav.contact')}
        </a>
      </li>
      <li class='pt-8 md:hidden md:pt-0 lg:pl-10'>
        <LangPicker />
      </li>
    </ul>
  </nav>
</navigation-controller>

<script>
  import '../scripts/navigation-controller';
</script>
