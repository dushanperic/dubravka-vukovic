---
import { getLangFromUrl, useTranslations, withBase } from '../i18n/utils';
import LangPicker from './LangPicker.astro';
import MenuIcon from './MenuIcon.astro';

const pathname = Astro.url.pathname;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const getNavLinkStyle = (path: string) => {
  return pathname.includes(path) ? 'active-link' : '';
};
---

<script>
  document.addEventListener('astro:page-load', () => {
    const btn = document.getElementById('nav-toggler');
    const background = document.getElementById('nav-background');
    const main = document.getElementById('main');
    btn?.addEventListener('click', (e) => {
      const nav = document.getElementById('navigation');

      nav?.classList.toggle('translate-x-full');
      background?.classList.toggle('invisible');
      main?.classList.toggle('opacity-40');
    });
  });
</script>

<MenuIcon id="nav-toggler" class:list={'z-9999 md:hidden ml-4 md:ml-0'} />

<nav>
  <ul
    id="navigation"
    class="flex pl-4 lg:pl-0 flex-col md:flex-row items-start justify-center ms:justify-end gap-4 md:gap-6 bg-(--background) fixed top-0 left-1/2 bottom-0 right-0 translate-x-full md:relative md:top-auto md:left-auto md:bottom-auto md:right-auto md:translate-none transition-all z-100"
  >
    <li class="">
      <a
        href={withBase(`/${lang}/areas`)}
        class:list={getNavLinkStyle('areas')}
        class="leading-0"
      >
        {t('nav.areas')}
      </a>
    </li>
    <li class="">
      <a
        href={withBase(`/${lang}/about`)}
        class:list={getNavLinkStyle('about')}
        class="leading-0"
      >
        {t('nav.biography')}
      </a>
    </li>
    <li class="">
      <a
        href={withBase(`/${lang}/contact`)}
        class:list={getNavLinkStyle('contact')}
        class="leading-0"
      >
        {t('nav.contact')}
      </a>
    </li>
    <li class="lg:pl-10 pt-8 lg:pt-0">
      <LangPicker />
    </li>
  </ul>
</nav>
