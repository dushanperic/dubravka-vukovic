<Main title={`${t('contact.title')} | ${t('site.title')}`}>
  <Section id="contact" transition:animate={pageTransition}>
    <PageTitle text={t('contact.title')} />

    <address class="mb-4 flex flex-col gap-2">
      <span class="inline-block w-auto">{t('contact.address.street')}</span>
      <span class="inline-block w-auto">{t('contact.address.city')}</span>
      <span class="inline-block w-auto">{t('contact.address.state')}</span>
      <span class="inline-block w-auto">
        <a href="mailto:advokatdubravkavukovic@gmail.com" target="_blank">
          advokatdubravkavukovic@gmail.com
        </a>
      </span>
      <span class="inline-block w-auto">
        <a href="tel:+38765862731" class="inline-block w-auto">
          Tel: +387 65 862 731
        </a>
      </span>
    </address>

