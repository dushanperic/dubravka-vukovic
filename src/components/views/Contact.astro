---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import Section from '../Section.astro';
import PageTitle from '../PageTitle.astro';
import Main from '../../layouts/main.astro';
import { LAYOUT_TYPE_KEY } from '../../config/layout';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Main
  title={`${t('contact.title')} | ${t('site.title')}`}
  pageTitle={t('contact.title')}
  layout={LAYOUT_TYPE_KEY.COL_3}
>
  <Section id='contact' class='md:col-span-2'>
    <PageTitle text={t('contact.title')} cls='md:hidden' />

    <div class='grid grid-cols-1 gap-(--grid-gap) md:grid-cols-2'>
      <address class='mb-4 flex flex-col gap-2'>
        <span class='inline-block w-auto'>{t('contact.address.street')}</span>
        <span class='inline-block w-auto'>{t('contact.address.city')}</span>
        <span class='inline-block w-auto'>{t('contact.address.state')}</span>
        <span class='inline-block w-auto'>
          <a href='mailto:advokatdubravkavukovic@gmail.com' target='_blank'>
            advokatdubravkavukovic@gmail.com
          </a>
        </span>
        <span class='inline-block w-auto'>
          <a href='tel:+38765862731' class='inline-block w-auto'>
            Tel: +387 65 862 731
          </a>
        </span>
      </address>

      <iframe
        src='https://www.google.com/maps/embed?pb=!1m13!1m11!1m3!1d568.7315464160856!2d17.995165815889063!3d45.14495153153463!2m2!1f0!2f0!3m2!1i1024!2i768!4f13.1!5e1!3m2!1sen!2srs!4v1793215608098!5m2!1sen!2srs'
        width='400'
        height='300'
        style='border:0;'
        allowfullscreen=''
        loading='lazy'
        class='w-full'
        referrerpolicy='strict-origin-when-cross-origin'></iframe>
    </div>
  </Section>
</Main>
