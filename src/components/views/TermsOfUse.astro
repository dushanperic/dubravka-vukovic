---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import Section from '../Section.astro';
import PageTitle from '../PageTitle.astro';
import Main from '../../layouts/main.astro';
import { LAYOUT_TYPE_KEY } from '../../config/layout';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Main
  title={`${t('terms_of_use.title')} | ${t('site.title')}`}
  pageTitle={t('terms_of_use.title')}
  layout={LAYOUT_TYPE_KEY.COL_3}
>
  <Section id='terms_of_use' class='md:col-span-2 xl:col-span-1'>
    <PageTitle text={t('terms_of_use.title')} cls='md:hidden' />

    <p class='max-w-full whitespace-pre-line'>
      {t('terms_of_use.content')}
    </p>
  </Section>
</Main>
