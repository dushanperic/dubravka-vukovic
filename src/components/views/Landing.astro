---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import Main from '../../layouts/main.astro';
import Section from '../Section.astro';
import TextSlideUp from '../TextSlideUp.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Main title={`${t('site.title')}`} layout="centered">
  <Section cls={'flex flex-col items-center justify-center'}>
    <div class="w-full md:w-2/3 lg:w-1/2 [&>div>p]:text-2xl!">
      <TextSlideUp text={t('landinng.title')} maxWidth="1200px" />
    </div>
  </Section>
</Main>
