---
import { LAYOUT_TYPE_KEY } from '../../config/layout';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import Main from '../../layouts/main.astro';
import Section from '../Section.astro';
import TextSlideUp from '../TextSlideUp.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Main title={`${t('site.title')}`} layout={LAYOUT_TYPE_KEY.COL_3}>
  <Section class='md:col-span-2 [&>div>h1]:text-2xl!'>
    <TextSlideUp text={t('landing.title')} maxWidth='1200px' />
  </Section>
</Main>
