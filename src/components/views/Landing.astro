---
import { LAYOUT_TYPE_KEY } from '../../config/layout';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import Main from '../../layouts/main.astro';
import Section from '../Section.astro';
import TextSlideUp from '../TextSlideUp.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Main title={`${t('site.title')}`} layout={LAYOUT_TYPE_KEY.COL_3} >
  <Section class="[&>div>p]:text-2xl! md:col-span-2">
    <TextSlideUp text={t('landinng.title')} maxWidth="1200px" />
  </Section>
</Main>
