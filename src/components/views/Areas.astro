---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import Section from '../Section.astro';
import PageTitle from '../PageTitle.astro';
import Main from '../../layouts/main.astro';
import { pageTransition } from '../../config/page-transitions';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

type AreaType =
  | 'legal_area.family_law'
  | 'legal_area.criminal_law'
  | 'legal_area.inferitance_law';

const legalAreas = [
  {
    title: 'legal_area.family_law' as AreaType,
    url: 'https://www.paragraf.ba/propisi/republika-srpska/porodicni-zakon.html',
    info: '("Sl. glasnik RS", br. 17/2023, 27/2024, 20/2025 - odluka US i 61/2025)',
  },
  {
    title: 'legal_area.criminal_law' as AreaType,
    url: 'https://www.paragraf.ba/propisi/republika-srpska/krivicni-zakon-republike-srpske.html',
    info: '("Sl. glasnik RS", br. 64/2017, 104/2018 - odluka US, 15/2021, 89/2021, 73/2023, "Sl. glasnik BiH", br. 9/2024 - odluka US BiH, "Sl. glasnik RS" 105/2024 - odluka US, 19/2025, "Sl. glasnik BiH", br. 14/2025 - odluka US BiH i "Sl. glasnik RS", br. 31/2025, 85/2025 - odluka US, 25/2026 i 78/2026)',
  },
  {
    title: 'legal_area.inferitance_law' as AreaType,
    url: 'https://www.paragraf.ba/propisi/republika-srpska/zakon-o-nasljedjivanju.html',
    info: '("Sl. glasnik RS", br. 64/2017, 104/2018 - odluka US, 15/2021, 89/2021, 73/2023, "Sl. glasnik BiH", br. 9/2024 - odluka US BiH, "Sl. glasnik RS" 105/2024 - odluka US, 19/2025, "Sl. glasnik BiH", br. 14/2025 - odluka US BiH i "Sl. glasnik RS", br. 31/2025, 85/2025 - odluka US, 25/2026 i 78/2026)',
  },
];
---

<Main title={`${t('areas.title')} | ${t('site.title')}`}>
  <Section id="areas" transition:animate={pageTransition}>
    <PageTitle text={t('areas.title')} />

    <ul class="flex flex-col gap-6 max-w-full md:max-w-1/2">
      {
        legalAreas.map((item, index) => (
          <li>
            <p class="mb-1">{t(item.title)}</p>
            <a
              href={item.url}
              target="_blank"
              class="block w-auto text-sm! leading-normal line-clamp-1 break-all"
            >
              {item.info}
            </a>
          </li>
        ))
      }
    </ul>
  </Section>
</Main>
