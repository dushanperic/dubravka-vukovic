---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import Section from '../Section.astro';
import PageTitle from '../PageTitle.astro';
import Main from '../../layouts/main.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Main
  title={`${t('biography.title')} | ${t('site.title')}`}
  pageTitle={t('biography.title')}
>
  <Section id="biography" cls="mt-20">
    <PageTitle text={t('biography.title')} cls="md:hidden" />
    <p class="max-w-full md:max-w-1/2 whitespace-pre-line">
      {t('biography.paragraph')}
    </p>
  </Section>
</Main>
