---
import { getLangFromUrl, useTranslations, withBase } from '../i18n/utils';
import Navigation from './Navigation.astro';
import ThemeToggler from './ThemeToggler.astro';

interface Props {
  title?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { title } = Astro.props;
---

<header
  class="w-full py-6 md:py-8 lg:py-10 top-0 fixed z-10 bg-(--background) px-6 md:px-8"
>
  <div class="max-w-400 mx-auto">
    <div
      class="w-full flex items-end md:grid md:grid-cols-3 md:gap-(--grid-gap) justify-between"
    >
      <a
        href={withBase(`/${lang}`)}
        class="z-900 flex items-start md:items-center justify-start gap-4 md:gap-8"
      >
        <h1 class="flex-clo md:flex-row[&>span]:mr-2">
          <span>
            {t('site.prefix')}
          </span>
          <span class="whitespace-nowrap">
            {t('site.name')}
          </span>
        </h1>
      </a>
      <span class="invisible md:visible">{title}</span>
      <div class="flex items-center justify-end">
        <Navigation />
        <ThemeToggler />
      </div>
    </div>
  </div>
</header>
