---
import { getLangFromUrl, useTranslations, withBase } from '../i18n/utils';
import Nav from './Nav.astro';
import ThemeToggler from './ThemeToggler.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header class="w-full py-2 md:py-6 top-0 sticky z-10">
  <div
    id="nav-background"
    class="fixed inset-0 backdrop-blur-xs invisible md:invisible"
  >
  </div>
  <div class="max-w-400 mx-auto">
    <div class="flex items-start md:items-start justify-between">
      <a
        href={withBase(`/${lang}`)}
        class="z-900 flex items-start md:items-center justify-start gap-4 md:gap-8"
      >
        <!-- <div
          class="relative flex items-center justify-center rounded-full w-10 h-10 min-w-10 min-h-10 leading-0 border-2"
        >
          <div
            class="absolute top-1/2 left-1/2 -translate-y-0.5 -translate-1/2"
          >
            §
          </div>
        </div> -->
        <h1 class="flex-clo md:flex-row[&>span]:mr-2">
          <span>
            {t('site.prefix')}
          </span>
          <span class="whitespace-nowrap">
            {t('site.name')}
          </span>
        </h1>
      </a>
      <div class="flex items-center justify-between">
        <Nav />
        <ThemeToggler />
      </div>
    </div>
  </div>
</header>
