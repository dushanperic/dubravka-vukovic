---
import { getLangFromUrl, useTranslations, withBase } from '../i18n/utils';
import Nav from './Nav.astro';
import ThemeToggler from './ThemeToggler.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header class="w-full py-2 md:py-6 top-0 sticky z-9999">
  <div class="max-w-300 mx-auto">
    <div class="flex items-center justify-between">
      <a
        href={withBase(`/${lang}`)}
        class="text-2xl! md:text-3xl! font-medium! z-9999 flex items-center justify-start gap-2 md:gap-4"
      >
        <div
          class="relative flex items-center justify-center rounded-full w-6 h-6 min-w-6 min-h-6 md:w-10 md:h-10 md:min-w-10 md:min-h-10 text-(--primary-brand) text-base md:text-2xl leading-0 border-(--primary-brand) border-2"
        >
          <div
            class="absolute top-1/2 left-1/2 -translate-y-0.5 -translate-1/2"
          >
            §
          </div>
        </div>
        <h1>{t('site.title')}</h1>
      </a>
      <div class="flex items-center justify-between">
        <Nav />
        <ThemeToggler />
      </div>
    </div>
  </div>
</header>
